datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// generator specifies the generation environment for the type-safe Prisma Client
generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & USER ROLES MODULE
// ==========================================

enum UserRole {
  STUDENT
  STAFF
  LECTURER
  ADMIN
  SUPER_ADMIN // Added for overarching system control
}

enum Department {
  REGISTRAR
  FINANCE
  FACULTY_HOD
  CAMPUS_OPERATIONS
  ESTATE_MANAGEMENT
  GENERAL_SUPPORT

  COMPUTER_SCIENCE
  SOFTWARE_ENGINEERING
  CIVIL_ENGINEERING
  BUSINESS_ADMINISTRATION
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  phoneNumber  String      @unique
  passwordHash String // Securely managed via bcrypt on the NestJS backend
  fullName     String
  role         UserRole    @default(STUDENT)
  department   Department? // Nullable because students don't belong to an administrative desk
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Existing Relations
  ticketsSubmitted Ticket[]        @relation("StudentTickets")
  ticketsProcessed TicketHistory[] @relation("StaffActions")

  // --- NEW ACADEMIC & AUDIT RELATIONS ---
  modulesTaught  Module[]        @relation("LecturerModules")
  grades         Grade[]         @relation("StudentGrades")
  auditLogs      AuditLog[]
  studentProfile StudentProfile? // ◄ Linked to the new Student Profile matrix

  @@index([email])
}

// ==========================================
// 2. ISSUE TRACKING PIPELINE
// ==========================================

enum IssueCategory {
  ACADEMIC_PROGRESSION_VERIFICATION
  ADMINISTRATIVE_OPERATIONAL_REQUESTS
  FINANCIAL_GATEWAYS
  DIRECT_SUPPORT_EXTERNAL_COMPLIANCE
}

enum TicketStatus {
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  RESOLVED
  REJECTED
}

model Ticket {
  id              String        @id @default(uuid())
  trackingCode    String        @unique
  studentId       String
  isInternational Boolean       @default(false)
  category        IssueCategory
  serviceName     String
  description     String        @db.Text
  status          TicketStatus  @default(SUBMITTED)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id])

  // Scheduling & Resolution Params
  assessmentDate  DateTime? // Stores the scheduled time slot for makeups
  assessmentVenue String? // Stores physical location parameters (e.g., "Lab 3")
  lecturerNotes   String?   @db.Text // Holds optional context or instructions

  isMarkAltered   Boolean? // true if marks were updated, false if confirmed valid
  revisedMarkInfo String? // e.g., "CAT 1 changed from 12/20 to 17/20. Final: 65%"
  hodAuditNotes   String?  @db.Text // Contextual feedback from checking the book sheet

  generatedTranscriptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student     User            @relation("StudentTickets", fields: [studentId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  history     TicketHistory[]

  @@index([trackingCode])
  @@index([status])
  @@index([category])
  @@index([moduleId])
}

// ==========================================
// 3. EVIDENCE & HISTORICAL LOGGING
// ==========================================

model Attachment {
  id         String   @id @default(uuid())
  ticketId   String
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketHistory {
  id            String       @id @default(uuid())
  ticketId      String
  staffId       String? // Can be null if system automated transitions happen
  previousState TicketStatus
  newState      TicketStatus
  comment       String?      @db.Text
  changedAt     DateTime     @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff  User?  @relation("StaffActions", fields: [staffId], references: [id])

  @@index([ticketId])
}

// ==========================================
// 4. THE ACADEMIC LEDGER
// ==========================================

model AcademicYear {
  id       String  @id @default(uuid())
  name     String  @unique // e.g., "2026-2027"
  isActive Boolean @default(false)

  modules Module[]

  createdAt DateTime @default(now())
}

model Module {
  id      String @id @default(uuid())
  code    String @unique // e.g., "CSC301"
  title   String
  credits Int

  // Relations
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  lecturerId String
  lecturer   User   @relation("LecturerModules", fields: [lecturerId], references: [id])

  grades        Grade[]
  registrations ModuleRegistration[] // ◄ Linked to student enrollments
  tickets       Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GradeStatus {
  PENDING
  PUBLISHED
  DISPUTED
}

// ◄ UPGRADED: The Advanced Grading Engine Schema
model Grade {
  id String @id @default(uuid())

  // 1. Raw Assessment Data (Stored as JSON arrays)
  // Format: [{ "name": "CAT 1", "score": 15, "max": 20 }, { "name": "Lab 1", "score": 8, "max": 10 }]
  cats        Json? @default("[]")
  assignments Json? @default("[]")

  // 2. Examination Data
  examScore Float?
  examMax   Float? @default(50)

  // 3. Computed Aggregates (The 50/50 Split Rule)
  caComputed   Float? // Dynamically scaled out of 50
  examComputed Float? // Dynamically scaled out of 50
  finalScore   Float? // caComputed + examComputed (Out of 100)

  status GradeStatus @default(PENDING)

  // Relations
  studentId String
  student   User   @relation("StudentGrades", fields: [studentId], references: [id])

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, moduleId])
}

// ==========================================
// 5. CRYPTOGRAPHIC AUDIT TRAIL
// ==========================================

model AuditLog {
  id         String @id @default(uuid())
  action     String // e.g., "TICKET_RESOLVED", "GRADE_PUBLISHED"
  entityName String // e.g., "Ticket", "Grade"
  entityId   String

  previousHash String
  currentHash  String @unique

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  timestamp DateTime @default(now())
  metadata     String?
}

// ==========================================
// 6. STUDENT PROFILE & MODULE REGISTRATION
// ==========================================

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrationNumber String    @unique
  nationalId         String?   @unique
  dateOfBirth        DateTime?

  campusLocation String // e.g., Nyarugenge, Gikondo, Huye
  college        String // e.g., College of Science and Technology
  program        String // e.g., BSc in Software Engineering
  academicYear   String // e.g., 2025-2026
  level          Int // e.g., 1, 2, 3, 4

  sponsorshipType      String // e.g., Government, Self-Sponsored
  isFinanciallyCleared Boolean @default(false)
  accommodationStatus  String? // e.g., Campus Hostel, Off-Campus

  registeredModules ModuleRegistration[] // ◄ The join table to academic modules

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ◄ NEW: Join table to track EXACTLY which modules a student takes and if it is a retake
model ModuleRegistration {
  id               String @id @default(uuid())
  studentProfileId String
  moduleId         String

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  module         Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  enrollmentType String // e.g., FIRST_ATTEMPT, RETAKE
  academicYear   String // Locks the registration to a specific year

  // A student can only register for a specific module once per academic year
  @@unique([studentProfileId, moduleId, academicYear])
}
